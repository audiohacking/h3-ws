# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
*.egg-info/
dist/
# PyInstaller work dir — keep build/macos/ release assets tracked
/build/H3-WS/
/build/h3_desktop/
# Legacy catch-all for other build leftovers, but not build/macos/
/build/*
!/build/macos/
!/build/macos/**
# Generated icon sources — ship the .icns only
/build/macos/H3-WS.iconset/

# OS
.DS_Store

# Runtime / local outputs
web_outputs/
web_uploads/
tmp/
logs/
benchmark_runs/

# Local MiniMax-H3 weights (gitignored so checkpoints stay on disk)
models/

web/node_modules/
web/dist/

# Runtime ffmpeg/ffprobe names for the PyAV shim
scripts/.h3-av-bin/

# h3.c build artifacts (vendored tree)
third_party/h3.c/h3
third_party/h3.c/*.o
third_party/h3.c/*.air
third_party/h3.c/*.metallib

# FastH3 Live experiment — set aside; never ship with Continuity
h3_live/
data/fasth3_live/

# Local agent tooling caches (memories, settings, hooks) — not project source
.claude/
.serena/
web/.claude/

# Local desktop/runtime config (machine-specific paths)
config.json
